<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css"/>
    <link rel="stylesheet" href="app.css"/>
    <link rel="stylesheet" href="Meatcorps.Engine.ArcadeClient.styles.css"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <title>App</title>
    <HeadOutlet/>
</head>

<body>
<Routes />

<script src="_framework/blazor.web.js"></script>
<script>
    (function () {
        // Poll the reconnect modal state and keep trying forever.
        const MODAL_ID = 'components-reconnect-modal';
        const RETRY_MS = 3000;      // interval between retries

        function tryReconnectForever() {
            const modal = document.getElementById(MODAL_ID);
            if (!modal) { setTimeout(tryReconnectForever, RETRY_MS); return; }

            location.reload();

            setTimeout(tryReconnectForever, RETRY_MS);
        }

        // Start loop after Blazor boot
        setTimeout(() => tryReconnectForever(), RETRY_MS);
    })();
</script>
</body>

</html>