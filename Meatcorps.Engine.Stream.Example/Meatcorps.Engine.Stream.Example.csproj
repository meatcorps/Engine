<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Meatcorps.Engine.Stream.Example</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Meatcorps.Engine.RayLib.Stream\Meatcorps.Engine.RayLib.Stream.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="bin\Debug\net10.0\runtimes\osx-arm64\native\libmeatcorps_stream.dylib" />
      <None Update="sound.wav">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Assets/**/*"/>
    </ItemGroup>
  
    <ItemGroup>
      <Content Include="Assets/**/*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
