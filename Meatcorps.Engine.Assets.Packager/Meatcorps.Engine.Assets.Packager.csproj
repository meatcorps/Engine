<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Meatcorps.Engine.Assets.Packager</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Meatcorps.Engine.Assets\Meatcorps.Engine.Assets.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Assets/**/*"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets/**/*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ClCompile Include="Assets\Shaders\bloom.fx"/>
        <ClCompile Include="Assets\Shaders\bloom_composite.fx"/>
        <ClCompile Include="Assets\Shaders\bloom_threshold.fx"/>
        <ClCompile Include="Assets\Shaders\chromaticaberration.fx"/>
        <ClCompile Include="Assets\Shaders\colorgrading.fx"/>
        <ClCompile Include="Assets\Shaders\crt_newpixie.fx"/>
        <ClCompile Include="Assets\Shaders\fixedpalette_tex.fx"/>
        <ClCompile Include="Assets\Shaders\fixedpalette8.fx"/>
        <ClCompile Include="Assets\Shaders\gaussian_blur.fx"/>
        <ClCompile Include="Assets\Shaders\paletteswap.fx"/>
        <ClCompile Include="Assets\Shaders\scanlines.fx"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

</Project>
